{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relay:agent-mailbox:request.v1",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ask": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "due": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "title",
    "ask",
    "inputs",
    "due"
  ],
  "additionalProperties": false
}
